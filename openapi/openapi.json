          "422": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/current": {
      "get": {
        "tags": [
          "Organizations"
        ],
        "responses": {
          "501": {
            "description": "Organization profile placeholder.",
            "content": {
              "application/json": {
                "schema": {
