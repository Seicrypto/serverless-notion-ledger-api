      }
    },
    "/dashboard/me": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "responses": {
          "501": {
            "description": "Current user dashboard placeholder.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/notion/query": {
      "post": {
        "tags": [
          "Notion"
        ],
        "responses": {
          "501": {
            "description": "Notion query placeholder.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/notion/mutate": {
      "post": {
        "tags": [
          "Notion"
        ],
        "responses": {
          "501": {
            "description": "Notion mutation placeholder.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
