{
  "name": "notion-ledger-api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply APP_DB --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "openapi:export": "node scripts/run-ts-entry.mjs scripts/export-openapi.ts",
    "test:repositories": "node scripts/run-ts-tests.mjs tests/repositories.test.ts tests/repositories-official-staffs.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  }
}
